# NEXUS KASAN Kernel Configuration
# Linux 5.15.40 - Memory debugging for CVE-2022-32250 UAF detection
#
# This config is merged ON TOP of nexus_baseline.config using:
#   scripts/kconfig/merge_config.sh -m nexus_baseline.config nexus_kasan.config
#
# KASAN will detect use-after-free at runtime and log:
#   - Exact allocation stack trace (where the object was kmalloc'd)
#   - Exact free stack trace (where it was kfree'd)
#   - The access that triggered the UAF
#
# WARNING: KASAN roughly doubles memory usage and slows execution ~2x.
#          Use -m 2G or more in QEMU (not 512M).

# --- Kernel Address Sanitizer ---
CONFIG_KASAN=y
CONFIG_KASAN_GENERIC=y
CONFIG_KASAN_INLINE=y
CONFIG_KASAN_STACK=y

# --- SLUB Allocator Debugging ---
CONFIG_SLUB_DEBUG=y
CONFIG_SLUB_DEBUG_ON=y

# --- Additional Memory Debugging ---
CONFIG_DEBUG_PAGEALLOC=y
CONFIG_DEBUG_OBJECTS=y
CONFIG_DEBUG_OBJECTS_FREE=y

# --- Stack Traces ---
CONFIG_STACKTRACE=y

# --- Kernel Debug Core ---
CONFIG_DEBUG_KERNEL=y
CONFIG_DEBUG_FS=y

# --- Function Graph Tracer (for call path tracing) ---
CONFIG_FUNCTION_GRAPH_TRACER=y
CONFIG_KPROBES=y
