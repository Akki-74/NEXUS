# NEXUS Baseline Kernel Configuration
# Linux 5.15.40 - Vulnerable baseline for CVE-2022-32250

# Core Architecture
CONFIG_64BIT=y
CONFIG_X86_64=y

# Virtualization Support (QEMU)
CONFIG_VIRTIO=y
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_NET=y
CONFIG_VIRTIO_BLK=y
CONFIG_NET_9P=y
CONFIG_NET_9P_VIRTIO=y
CONFIG_9P_FS=y

# Serial Console (REQUIRED for -nographic QEMU boot)
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_SERIAL_8250_PCI=y
CONFIG_TTY=y
CONFIG_SERIAL_CORE=y
CONFIG_SERIAL_CORE_CONSOLE=y

# Filesystems
CONFIG_EXT4_FS=y
CONFIG_TMPFS=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y

# Initramfs support (REQUIRED for -initrd boot)
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y

# Device filesystem
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y

# Namespaces (REQUIRED for unprivileged exploitation)
CONFIG_NAMESPACES=y
CONFIG_USER_NS=y
CONFIG_NET_NS=y
CONFIG_PID_NS=y
CONFIG_IPC_NS=y
CONFIG_UTS_NS=y

# Netfilter (Target subsystem)
CONFIG_NETFILTER=y
CONFIG_NETFILTER_ADVANCED=y
CONFIG_NF_TABLES=y
CONFIG_NF_TABLES_INET=y
CONFIG_NF_TABLES_IPV4=y
CONFIG_NF_TABLES_IPV6=y
CONFIG_NETFILTER_NETLINK=y
CONFIG_NFT_COMPAT=y

# Networking
CONFIG_NET=y
CONFIG_INET=y
CONFIG_IPV6=y

# Debugging & Symbols
CONFIG_DEBUG_INFO=y
CONFIG_DEBUG_INFO_DWARF4=y
CONFIG_GDB_SCRIPTS=y
CONFIG_FRAME_POINTER=y
CONFIG_KALLSYMS=y
CONFIG_KALLSYMS_ALL=y

# Disable KASLR for easier debugging
CONFIG_RANDOMIZE_BASE=n

# Basic tracing
CONFIG_FTRACE=y
CONFIG_FUNCTION_TRACER=y
CONFIG_DYNAMIC_FTRACE=y
